#1generate random umber
#2 check wich number are even/odd
#3 rounds numbers using math
#4 count how many times numbers appear
#5 saves the result in a file

import random
import os
import math
import re
from collections import Counter
numbers = [random.randint(1,10)for _ in range(10)] 
#even or odd
even_numbers = []
odd_numbers = []
for num  in numbers:
    num_str = str(num)
    if re.search(r"^[02468]&",num_str):
        even_numbers.append(num)
    else:
        odd_numbers.append(num)

#for calculating average
average = sum(numbers)/len(numbers)
#round of the average
rounded_avg = math.ceil(average)
#count numbers
count_numbers = Counter(numbers)
#save result using os
if not os.path.exists("easy_reports"):
    os.mkdir("easy_reports")
#file path
file_path = os.path.join("easy_reports","number_reports.txt")

#write data to file
file = open(file_path,"w")
file.write(f"Generated Numbers:{numbers}")
file.write(f"even numbers:{even_numbers}")
file.write(f"odd numbers:{odd_numbers}")
file.write(f"average:{rounded_avg}")
file.write(f"number count:\n")
for num,count in count_numbers.items():
    file.write(f"{num}:{count}\n")
file.close()

print("///")
